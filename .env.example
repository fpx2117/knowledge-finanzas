
DATABASE_URL=postgresql://finance:finance@localhost:5433/know_finanzas
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NODE_ENV=development

# Test-only database; never point this at development or production data.
TEST_DATABASE_URL=postgresql://finance:finance@localhost:5433/know_finanzas_test

# Optional infrastructure
REDIS_URL=

# Optional brand logos via logo.dev (https://logo.dev). Publishable key ("pk_..."), safe to expose
# in the browser — it goes in the <img src> URL. Without it, the UI falls back to monogram chips.
NEXT_PUBLIC_LOGO_DEV_TOKEN=
# Secret key ("sk_..."), server-only — for the logo.dev brand-search API. Not required today.
LOGO_DEV_SECRET_KEY=

# Optional AI capability. Set AI_ENABLED=true only with both values configured.
AI_ENABLED=false
AI_CATEGORIZATION_ENABLED=false
OPENROUTER_API_KEY=
AI_MODEL_FAST=
AI_MODEL_BALANCED=
AI_MODEL_QUALITY=
AI_MODEL_REASONING=
OPENROUTER_APP_NAME=
OPENROUTER_APP_URL=
# KAI AI budget guard (spec §19) — hard USD ceilings on KAI's LLM fallback, on top of the credit
# pools. 0 / unset = no extra ceiling. Per-user daily cap is a runaway-cost circuit breaker; the
# global monthly cap protects the whole account.
KAI_USER_DAILY_USD=0
KAI_GLOBAL_MONTHLY_USD=0
# Consultas mensuales de KAI para FREE (respuesta con datos = 1, análisis con IA = 5).
# TRIAL y PRO son ilimitados.
FREE_KAI_POINTS_PER_PERIOD=150

# Commercial catalog and product access. Values are validated centrally and remain configurable.
TRIAL_DURATION_DAYS=14
# Permanent freemium tier: small monthly AI allowance (reused PLAN_ALLOWANCE pool, granted per
# calendar month), no WhatsApp. Every authenticated user gets at least this.
FREE_AI_CREDITS_PER_PERIOD=15
FREE_WHATSAPP_PER_PERIOD=0
TRIAL_AI_CREDITS_TOTAL=50
TRIAL_WHATSAPP_TOTAL=3
PRO_AI_CREDITS_PER_PERIOD=300
PRO_WHATSAPP_PER_PERIOD=20
# Argentina-first: primary PRO plan priced in ARS. USD plan for international cards is a separate
# future catalog entry — see docs/pricing/00-freemium-and-pricing-analysis.md.
PRO_MONTHLY_PRICE=8999
PRO_MONTHLY_CURRENCY=ARS

# Optional billing capability. Set BILLING_ENABLED=true only with all provider values configured.
BILLING_ENABLED=false
BILLING_NEW_SUBSCRIPTIONS_ENABLED=false
BILLING_GRACE_PERIOD_DAYS=0
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PRO_MONTHLY_PLAN_ID=

# Optional notifications. Channels stay disabled until provider credentials and policies are configured.
NOTIFICATIONS_ENABLED=false
REALTIME_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
WHATSAPP_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional S3-compatible storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bearer token protecting /api/health/deep. Required in production; optional in development.
INTERNAL_HEALTH_TOKEN=

# Bearer token for the scheduled routes under /api/cron/* (fx quote refresh, notification sweep).
# A platform scheduler (Vercel/Railway cron) must send `Authorization: Bearer <CRON_SECRET>`.
# When unset those routes return 404 (disabled).
CRON_SECRET=

# Pricing / unit-economics planning assumptions (TASK-046) — never technical invariants, never
# read by finance/domain logic. Defaults below match the documented reference scenario exactly.
# PRICING_CONFIG_VERSION=pricing-config:v1
# PRICING_CURRENCY_CODE=USD
# ASSUMED_GATEWAY_FEE_RATE=0.10
# ASSUMED_AI_COST_PER_CREDIT=0.01
# ASSUMED_WHATSAPP_COST_PER_MESSAGE=0.01
# AI_COST_TARGET_PER_PRO_USER=0.60
# WHATSAPP_COST_TARGET_PER_PRO_USER=0.30
# INFRASTRUCTURE_ALLOCATION_PER_PRO_USER=0.40
# OTHER_COST_PER_PRO_USER=0.15
# AI_COST_GUARDRAIL_PER_PRO_USER=1.00
# WHATSAPP_COST_GUARDRAIL_PER_PRO_USER=0.50
# GATEWAY_FEE_GUARDRAIL_RATE=0.15
# CONTRIBUTION_MARGIN_GUARDRAIL_MIN=3.00
